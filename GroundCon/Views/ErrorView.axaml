<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GroundCon.Views.ErrorView"
        Title="GroundCon" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" FontSize="20">
    <StackPanel Margin="10" Spacing="10" MaxWidth="400">
        <TextBlock Text="{Binding Path=Message}" TextWrapping="Wrap" />
        <Button Name="Ok" HorizontalAlignment="Right" Content="OK" />
    </StackPanel>
</Window>
